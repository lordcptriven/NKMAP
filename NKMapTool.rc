/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP  MOVEABLE PURE   "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\NKMapTool.ico"
IDR_NKMAPTTYPE          ICON    DISCARDABLE     "res\\NKMapToolDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  32, 31
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_TOOL_VERTEX_EDIT_ICON
    BUTTON      ID_TOOL_TEXTURE_PAINT_ICON
    BUTTON      ID_TOOL_OBJECT_EDIT_ICON
    BUTTON      ID_TOOL_LIGHT_EDIT_ICON
    BUTTON      ID_TOOL_ATMOS_EDIT_ICON
    BUTTON      ID_TOOL_ATTRIBUTE_EDIT_ICON
    SEPARATOR
    BUTTON      ID_TOOL_MAPMOVE_ICON
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Open &Game Map",              ID_FILE_OPEN_GAME_MAP
        MENUITEM "&Close",                      ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...",                 ID_FILE_SAVE_AS
        MENUITEM "Save &Game Map",              ID_FILE_SAVE_GAME_MAP
        MENUITEM SEPARATOR
        MENUITEM "&Merge Map",                  ID_FILE_MERGE_MAP
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Terrain\tT",                 ID_VIEW_TERRAIN
        MENUITEM "&Object\tO",                  ID_VIEW_OBJECT
        MENUITEM "&Water\tW",                   ID_VIEW_WATER
        MENUITEM "&Sky\tS",                     ID_VIEW_SKY
        MENUITEM "&Fog\tF",                     ID_VIEW_FOG
        MENUITEM "&Character\tK",               ID_VIEW_CHARACTER
        MENUITEM "Attr_map\tA",                 ID_VIEW_ATTR_MAP
        POPUP "&Grid\tG"
        BEGIN
            MENUITEM "&None",                       ID_VIEW_GRID_NONE
            MENUITEM "&Small",                      ID_VIEW_GRID_SMALL
            MENUITEM "&Medium",                     ID_VIEW_GRID_MEDIUM
            MENUITEM "&Large",                      ID_VIEW_GRID_LARGE
        END
        MENUITEM SEPARATOR
        MENUITEM "Too&lbar",                    ID_VIEW_TOOLBAR
        MENUITEM "St&atus Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Terrain &Vertex Editor\tCtrl+V", ID_TOOL_VERTEX_EDIT
        MENUITEM "Terrain &Texture Paintor\tCtrl+T", ID_TOOL_TEXTURE_PAINT
        MENUITEM "O&bject Editor\tCtrl+B",      ID_TOOL_OBJECT_EDIT
        MENUITEM "Terrain &Light Editor\tCtrl+L", ID_TOOL_LIGHT_EDIT
        MENUITEM "Atmos&phere Editor\tCtrl+P",  ID_TOOL_ATMOSPHERE_EDIT
        MENUITEM "Terrain &Attribute Map Editor\tCtrl+A", 
                                                ID_TOOL_ATTRIBUTE_EDIT
        MENUITEM SEPARATOR
        MENUITEM "Map &Movement\tCtrl+M",       ID_TOOL_MAPMOVE
    END
    POPUP "&Camera"
    BEGIN
        POPUP "&Type\tC"
        BEGIN
            MENUITEM "&Observing Mode",             ID_CAMERA_OBSERVE
            MENUITEM "&Flying Mode",                ID_CAMERA_FLY
        END
        POPUP "Speed"
        BEGIN
            MENUITEM "x1",                          ID_CAMERA_SPEED1X
            MENUITEM "x2",                          ID_CAMERA_SPEED2X
            MENUITEM "x4",                          ID_CAMERA_SPEED4X
            MENUITEM "x8",                          ID_CAMERA_SPEED8X
            MENUITEM "x10",                         ID_CAMERA_SPEED10X
        END
        MENUITEM "Unlimit",                     ID_CAMERA_UNLIMIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About NKMapTool...",         ID_APP_ABOUT
    END
END


