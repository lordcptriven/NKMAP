IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 221, 354
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION " About NKMapTool"
FONT 10, "MS Sans Serif"
BEGIN
    CONTROL         184,IDC_STATIC,"Static",SS_BITMAP | SS_REALSIZEIMAGE,7,
                    11,19,23
    LTEXT           "NKMapTool Version 1.1",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2003      Nako Interactive",IDC_STATIC,39,
                    22,123,8
    DEFPUSHBUTTON   "OK",IDOK,164,7,50,14,WS_GROUP
    LTEXT           "Revision : Nam Woo Hyun",IDC_STATIC,39,35,129,8
    LTEXT           "Ver 1.1 Open Game Map 버그수정",IDC_STATIC,12,66,131,8
    GROUPBOX        "버전 관리",IDC_STATIC,7,56,207,291
    LTEXT           "일부 차일드 다이얼로그  버튼 단축키 기능 추가 (오브젝트 다이얼로그 4버튼, 텍스쳐 페인트 다이얼로그 2버튼)",
                    IDC_STATIC,15,91,187,19
    LTEXT           "오브젝트 좌표축 로컬모드 셋팅 기능(회전에 따라 함께 돌아감) 로컬모드 좌표축으로 Array기능 강화 ",
                    IDC_STATIC,16,126,184,19
    LTEXT           "Ver 1.2",IDC_STATIC,12,79,23,8
    LTEXT           "Ver 1.3",IDC_STATIC,13,113,23,8
    LTEXT           "Ver 1.4",IDC_STATIC,13,149,23,8
    LTEXT           "속성 브러쉬 크기 확장 기능 추가(마우스휠로도 조절 가능)",
                    IDC_STATIC,16,161,170,8
    LTEXT           "방향키 카메라 이동 속도 조절 기능 확장(단축키 Ctrl + 1,2,3으로도 조절 가능)",
                    IDC_STATIC,16,172,179,17
    LTEXT           "텍스쳐 페인트 다이얼로그의 레이어 버튼의 위치 변경(1번과 3번의 순서를 변경)",
                    IDC_STATIC,16,191,179,17
    LTEXT           "Ver 1.5",IDC_STATIC,14,211,23,8
    LTEXT           "오브젝트 셀렉트 기능을 조금도 잘되게 변경.(세세한 체크를 안하게 변경)",
                    IDC_STATIC,16,222,182,17
    LTEXT           "Ver 1.6",IDC_STATIC,15,242,23,8
    LTEXT           "카메라 이동속도 조절기능에 x8,x10 추가",IDC_STATIC,17,
                    253,120,8
    LTEXT           "Ver 1.7",IDC_STATIC,16,266,23,8
    LTEXT           "오브젝트가 보이는 카메라 시야 거리 증가(반투명 출력 체크거리도 증가)",
                    IDC_STATIC,19,276,189,20
    LTEXT           "Ver 1.8",IDC_STATIC,14,298,23,8
    LTEXT           "속성맵 보기 옵션 추가",IDC_STATIC,17,309,68,11
END


